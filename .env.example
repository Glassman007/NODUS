# Set a strong password in .env. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL is reserved for transactional task metadata and the outbox.
POSTGRES_USER=graphhacks
POSTGRES_PASSWORD=
POSTGRES_DB=graphhacks
POSTGRES_PORT=5432
# POSTGRES_DSN=postgresql://graphhacks:<password>@localhost:5432/graphhacks

# Map opaque bearer tokens to tenant, authorized workspaces and permissions.
# GRAPH_HACKS_API_PRINCIPALS_JSON={"token":{"subject":"user","tenant_id":"tenant","workspaces":["workspace"],"source_ids":["github"],"permissions":["READ_GRAPH","READ_EVIDENCE","MANAGE_INGESTION"]}}
GRAPH_HACKS_API_PRINCIPALS_JSON=

# Optional token used by scripts/import_json.py. It must match one configured principal.
GRAPH_HACKS_API_TOKEN=
